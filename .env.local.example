# Copy this file to ".env.local" and fill in your real values, then restart the app.
# .env.local is gitignored and never sent to the browser.

# ── Gmail SMTP (recommended — sends from your Gmail address) ──
# 1. Turn on 2-Step Verification: https://myaccount.google.com/security
# 2. Create an App Password: https://myaccount.google.com/apppasswords
#    (choose "Mail" → device "Other" → name it "LCL Ops") — you get 16 characters.
# 3. Paste below (remove the spaces Google shows, or keep them, both work).
GMAIL_USER=landlordcompliancelondon@gmail.com
GMAIL_APP_PASSWORD=your16charapppassword

# ── Resend (alternative — only works from a domain you verify, NOT gmail.com) ──
# RESEND_API_KEY=re_your_key_here

# ── Supabase (shared cloud database) ──
# Supabase dashboard → your project → Settings → API.
# These two are safe to expose to the browser (NEXT_PUBLIC_), the anon key is
# meant to be public. Restart the app after adding them.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_public_key

# Server-only secret (Settings → API → service_role). NEVER NEXT_PUBLIC.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_secret

# ── Gmail Push Notifications (instant inbound replies, replaces 5s polling) ──
# 1. Create a Google Cloud project + enable Gmail API + Cloud Pub/Sub.
# 2. Create an OAuth 2.0 client (Web application), run the OAuth flow once to
#    get a refresh token, paste below.
# 3. Create a Pub/Sub topic + subscription pointing to:
#    https://lcl-ops.vercel.app/api/gmail/webhook
# 4. Grant the gmail service account (gmail-api-push@system.gserviceaccount.com)
#    "Pub/Sub Publisher" on the topic.
# 5. Hit POST /api/gmail/watch to register (or re-register every 7 days).
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_PUBSUB_TOPIC=projects/YOUR_PROJECT/topics/YOUR_TOPIC
GMAIL_WEBHOOK_SECRET=

# ── WhatsApp Business (Meta Cloud API) — optional, for auto-send ──
# Meta for Developers → your app → WhatsApp → API setup.
# WHATSAPP_TOKEN = a permanent System User access token (not the temporary 24h one).
# WHATSAPP_PHONE_NUMBER_ID = the "Phone number ID" on the API Setup page.
# Server-only. Without these, the app falls back to click-to-send (wa.me).
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# ── Vapi (AI calling agent) — optional, for the "AI Call" button on Prospects ──
# See VAPI_SETUP.md for step-by-step setup. Without these, the button shows
# "AI calling isn't set up yet".
VAPI_API_KEY=
VAPI_ASSISTANT_ID=
VAPI_PHONE_NUMBER_ID=
# Shared secret you choose — set the same value as the Vapi assistant's
# server webhook header "x-vapi-secret".
VAPI_WEBHOOK_SECRET=
